{
  "name": "english-shadowing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Practise English pronunciation on any web page: select text, listen, shadow it, review what you practised.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "verify": "npm run lint && npm run compile && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "0.3.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
