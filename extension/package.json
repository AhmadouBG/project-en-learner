{
  "name": "english-shadowing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Practise English pronunciation on any web page: select text, listen, shadow it, review what you practised.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "verify": "npm run lint && npm run compile && npm run test && npm run build && npm run check:ipa && npm run check:dict-runtime && npm run check:panel && npm run check:shortcut",
    "build:dict": "node scripts/build-dict.mjs",
    "check:ipa": "node scripts/check-ipa.mjs",
    "check:dict-runtime": "node scripts/check-dict-runtime.mjs",
    "check:panel": "node scripts/check-phase6.mjs",
    "check:selection": "node scripts/check-selection.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "check:shadow": "node scripts/check-shadow-mount.mjs",
    "check:shortcut": "node scripts/check-shortcut.mjs",
    "check:recording": "node scripts/check-recording.mjs",
    "check:permission": "node scripts/check-permission.mjs",
    "check:hardening": "node scripts/check-hardening.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "0.3.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
